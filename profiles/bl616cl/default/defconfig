# arduino-bl dependency profile: bl616cl/default.
# Use wl80211 as selected on 2026-10-22; inherit components/Wi-Fi configuration from SDK macsw_bare.
# USB device uses CDC ACM with optional HID, selected for ARDUINO-42 on 2026-10-23.
# Unlike macsw_bare, omit SHELL/IPERF and bl618dg/GCOV branches; Arduino does not expose the SDK shell.
# Use the upstream BL616CL uarthci Controller with an external Host; unused BLE does not link the Controller.
# TLS adds P-384, P-521, X25519 and bl_crt_bundle; other mbedTLS settings retain SDK defaults.

CONFIG_BFLB_LOG          =n
CONFIG_FREERTOS          =y
CONFIG_POSIX             =n
CONFIG_TLSF              =y
CONFIG_LWIP              =y
CONFIG_IPV6              =y
CONFIG_WL80211           =y
CONFIG_BL_WPA_SUPPLICANT =y
CONFIG_WIFI6             =y
CONFIG_RF                =y
CONFIG_MBEDTLS           =y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED =y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED =y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED =y
CONFIG_X509_CERTIFICATE_BUNDLE =y
CONFIG_DHCPD             =y
CONFIG_PING              =y
CONFIG_BACKTRACE         =y

CONFIG_BLUETOOTH         =y
CONFIG_BTBLECONTROLLER_LIB =uarthci
CONFIG_BLE_HOST_DISABLE  =y
CONFIG_BLE_USE_MAC2       =n

CONFIG_WL80211_WRAM_MEM_SIZE_LIMIT = 0x10000 # 64KB

CONFIG_VSNPRINTF_FLOAT        =y
CONFIG_VSNPRINTF_FLOAT_EX     =y
CONFIG_VSNPRINTF_LONG_LONG    =y

CONFIG_MACSW_SELECT      = default

CONFIG_CHERRYUSB                =y
CONFIG_CHERRYUSB_OSAL           =freertos
CONFIG_CHERRYUSB_DEVICE         =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM =y
CONFIG_CHERRYUSB_DEVICE_HID     =y

# ARDUINO-46: explicit filesystem partition; no SDK autoformat/VFS.
CONFIG_PARTITION =y
CONFIG_BFLB_MTD =y
CONFIG_OVERRIDE_PTFILE =partition_cfg_4M_lfs_v1.toml
CONFIG_FLASH_XIP_LENGTH =0x17d800

# Build the chip OTA engine without erasing the whole inactive slot at begin.
CONFIG_FOTA =y
CONFIG_FAST_OTA =0
