bl616cl: build with the standard-ISA GCC 14.3 toolchain

GCC 14.3 (bouffalolab/toolchain gcc-riscv-14.3.0) rejects the T-Head
-march=rv32imafc_xtheade and -mtune=e907 options and ships picolibc only.
Build BL616CL with rv32imafc_zicsr_zifencei/ilp32f and picolibc, reusing
the SDK's existing BL618DG B0 picolibc port.

The CSI header already hard-codes T-Head cache/sync instructions (.word,
.insn) and the mxstatus/mhcr/mhint CSRs by number. Do the same for the
remaining named non-standard CSRs (mtvt 0x307, mnxti 0x345, mintstatus
0x346, fxcr 0x800), which binutils 2.43 does not know. Numbers match the
Xuantie assembler encoding.

TLS: picolibc keeps errno and other libc state in __thread variables reached
through tp. The FreeRTOS port never changes tp, so give the image one static
TLS block (copied and cleared by start_load) and point tp at it in start.S.
This matches the single global newlib reent used before.

libc glue: picolibc time() calls gettimeofday() directly, so add it next to
the existing _gettimeofday_r. This toolchain's libstdc++ uses POSIX gthreads,
so sys/types.h must expose the toolchain pthread types; keep skipping them
for picolibc builds that do not ship sys/_pthreadtypes.h.

errno: picolibc functions write their TLS errno, while SDK code and the
Arduino package read errno through __errno() (__PICOLIBC_ERRNO_FUNCTION and
lwipopts.h). Make the FreeRTOS __errno() return picolibc's errno so all of
them share one object.

Upstream status: not upstream; SDK 1cd1fd51 only supports Xuantie GCC for
BL616CL. Remove when the SDK builds BL616CL with GCC 14.3.

--- a/bsp/board/bl616cldk/bl616cl_common.ld.in
+++ b/bsp/board/bl616cldk/bl616cl_common.ld.in
@@ -364,6 +364,31 @@
         __bflb_log_tags_end__ = .;
     } > ram AT > rom
 
+    /* picolibc thread-local storage: one static block for all tasks, like the
+     * single newlib reent before. start.S points tp at __tls_base and
+     * start_load copies .tdata and clears .tbss. */
+    SECTION_LOAD_PROLOGUE(ram_tdata, ,)
+    {
+        __tls_base = .;
+        *(.tdata .tdata.*)
+        . = ALIGN(4);
+    } > ram AT > rom
+
+    SECTION_PROLOGUE(ram_tbss, (NOLOAD),)
+    {
+        *(.tbss .tbss.* .tcommon)
+        . = ALIGN(4);
+    } > ram
+
+    /* The linker does not advance the location counter over .tbss; reserve it. */
+    SECTION_PROLOGUE(ram_tbss_space, (NOLOAD),)
+    {
+        . = ABSOLUTE(ADDR(ram_tbss) + SIZEOF(ram_tbss));
+    } > ram
+
+    ASSERT((SIZEOF(ram_tdata) > 0 ? ADDR(ram_tdata) : ADDR(ram_tbss)) == __tls_base,
+           "TLS segment must start at __tls_base")
+
     SECTION_PROLOGUE(ram_bss, (NOLOAD),)
     {
         . = ALIGN(4);
@@ -486,6 +511,7 @@
         LONG(__tcm_rodata_start__);         LONG(__tcm_rodata_end__);         LONG(__tcm_rodata_load__);
         LONG(__tcm_data_start__);           LONG(__tcm_data_end__);           LONG(__tcm_data_load__);
         LONG(__ram_data_start__);           LONG(__ram_data_end__);           LONG(__ram_data_load__);
+        LONG(__ram_tdata_start__);          LONG(__ram_tdata_end__);          LONG(__ram_tdata_load__);
 #if defined(CONFIG_PSRAM_COPY_CODE) && !defined(CONFIG_PSRAM_XIP)
         LONG(__psram_text_start__);         LONG(__psram_text_end__);         LONG(__psram_text_load__);
         LONG(__psram_rodata_start__);       LONG(__psram_rodata_end__);       LONG(__psram_rodata_load__);
@@ -496,6 +522,7 @@
         LONG(0xffffffff);                   LONG(0xffffffff);                 LONG(0xffffffff);
 
         . = ALIGN(4); __mem_setz_sections = ABSOLUTE(.);
+        LONG(__ram_tbss_start__);           LONG(__ram_tbss_end__);
         LONG(__ram_bss_start__);            LONG(__ram_bss_end__);
         LONG(__wifi_bss_start__);           LONG(__wifi_bss_end__);
 #ifndef CONFIG_PSRAM_XIP
