+#if defined(__PICOLIBC__)
+    /* picolibc functions set their own (TLS) errno. SDK code reads errno through
+     * __errno() (__PICOLIBC_ERRNO_FUNCTION, lwipopts.h), so return that object. */
+#undef errno
+    extern __THREAD_LOCAL_ERRNO int errno;
+    return &errno;
+#else
