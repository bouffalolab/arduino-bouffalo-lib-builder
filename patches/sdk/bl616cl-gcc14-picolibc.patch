--- a/components/libc/newlib/port_time.c
+++ b/components/libc/newlib/port_time.c
@@ -97,3 +97,11 @@
 {
     return _settimeofday_r(_REENT, tp, tzp);
 }
+
+#if defined(__PICOLIBC__)
+/* picolibc time() calls gettimeofday() directly; newlib went through _gettimeofday_r. */
+__attribute__((weak)) int gettimeofday(struct timeval *tp, void *tzvp)
+{
+    return _gettimeofday_r(_REENT, tp, tzvp);
+}
+#endif
